# .gitignore

# Temporary processing artifacts
.tmp/

# Secrets and local config
.env
*.env
.env.*

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
venv/
env/
.venv/

# Node
node_modules/
npm-debug.log*
yarn-error.log*

# Logs
*.log
logs/
